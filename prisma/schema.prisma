// Prisma schema for the TV/Electronics E-Commerce Platform
// See REQUIREMENTS.md and the approved architecture plan for context.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity ----------

enum Role {
  CUSTOMER
  DEALER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique
  email         String?
  name          String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  locale        String     @default("en")
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  customerProfile CustomerProfile?
  dealerProfile   DealerProfile?
  staffProfile    StaffProfile?

  addresses         Address[]
  carts             Cart[]
  orders            Order[]
  wishlist          Wishlist[]
  couponRedemptions CouponRedemption[]
  statusChanges     OrderStatusHistory[] @relation("StatusChangedBy")
  deliveryAssignments DeliveryAssignment[]
}

enum OtpPurpose {
  LOGIN
  SIGNUP
}

model OtpChallenge {
  id          String     @id @default(cuid())
  phone       String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose])
}

model CustomerProfile {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json?
}

enum DealerTier {
  BRONZE
  SILVER
  GOLD
}

enum DealerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DealerProfile {
  id               String                @id @default(cuid())
  userId           String                @unique
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  gstNumber        String?
  dealerCode       String                @unique
  tier             DealerTier            @default(BRONZE)
  creditLimit      Decimal               @default(0) @db.Decimal(12, 2)
  approvalStatus   DealerApprovalStatus  @default(PENDING)
  assignedStaffId  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  orders Order[]
}

model StaffProfile {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String?
  permissions Json   @default("{}")
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String      @default("IN")
  phone      String
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
}

// ---------- Catalog ----------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToSub")
  sortOrder Int        @default(0)
  imageUrl  String?

  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  brand       String?
  description String?
  specs       Json          @default("{}")
  status      ProductStatus @default(DRAFT)
  erpItemCode String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants ProductVariant[]

  @@index([categoryId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique
  attributes  Json     @default("{}")
  erpItemCode String?  @unique
  imageUrls   Json     @default("[]")
  createdAt   DateTime @default(now())

  prices          Price[]
  inventory       Inventory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistedBy    Wishlist[]

  @@index([productId])
}

// ---------- Pricing & Stock ----------

enum PriceListCode {
  RETAIL
  DEALER_BRONZE
  DEALER_SILVER
  DEALER_GOLD
}

model PriceList {
  id       String        @id @default(cuid())
  code     PriceListCode @unique
  name     String
  currency String        @default("INR")

  prices Price[]
}

model Price {
  id            String    @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceListId   String
  priceList     PriceList @relation(fields: [priceListId], references: [id])
  mrp           Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  @@index([variantId, priceListId])
}

model Inventory {
  id               String   @id @default(cuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseCode    String   @default("MAIN")
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  lastSyncedAt     DateTime?

  @@unique([variantId, warehouseCode])
}

// ---------- Cart / Order ----------

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  sessionId String     @unique
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(12, 2)

  @@unique([cartId, variantId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  dealerProfileId    String?
  dealerProfile      DealerProfile? @relation(fields: [dealerProfileId], references: [id])
  status             OrderStatus   @default(PENDING)
  shippingAddressId  String?
  shippingAddress    Address?      @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId   String?
  billingAddress     Address?      @relation("BillingAddress", fields: [billingAddressId], references: [id])
  subtotal           Decimal       @db.Decimal(12, 2)
  discountTotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal       Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal       @db.Decimal(12, 2)
  couponId           String?
  coupon             Coupon?       @relation(fields: [couponId], references: [id])
  erpSalesOrderId     String?
  placedAt            DateTime      @default(now())

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payment          Payment?
  deliveryAssignment DeliveryAssignment?
  returnRequests   ReturnRequest[]
  couponRedemption CouponRedemption?

  @@index([userId])
  @@index([dealerProfileId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)

  returnRequests ReturnRequest[]

  @@index([orderId])
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        OrderStatus
  note          String?
  changedByUserId String?
  changedBy     User?       @relation("StatusChangedBy", fields: [changedByUserId], references: [id])
  changedAt     DateTime    @default(now())

  @@index([orderId])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(CREATED)
  method            PaymentMethod?
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// ---------- Merchandising ----------

enum CouponType {
  PERCENT
  FLAT
}

model Coupon {
  id                  String     @id @default(cuid())
  code                String     @unique
  type                CouponType
  value               Decimal    @db.Decimal(12, 2)
  minOrderValue       Decimal?   @db.Decimal(12, 2)
  maxDiscount         Decimal?   @db.Decimal(12, 2)
  startsAt            DateTime?
  endsAt              DateTime?
  usageLimit          Int?
  perUserLimit        Int?
  applicableRoles     Json       @default("[]")
  applicableCategoryIds Json     @default("[]")
  active              Boolean    @default(true)
  createdAt           DateTime   @default(now())

  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  redeemedAt DateTime @default(now())

  @@index([couponId, userId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, variantId])
}

// ---------- Delivery ----------

model PincodeServiceability {
  id            String  @id @default(cuid())
  pincode       String  @unique
  city          String?
  state         String?
  serviceable   Boolean @default(true)
  codAvailable  Boolean @default(false)
  estimatedDays Int     @default(5)
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

model DeliveryAssignment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffId        String?
  staff          User?          @relation(fields: [staffId], references: [id])
  assignedAt     DateTime       @default(now())
  status         DeliveryStatus @default(ASSIGNED)
  trackingNumber String?
  courierName    String?
  notes          String?
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  REFUNDED
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  reason      String
  status      ReturnStatus @default(REQUESTED)
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?
}

// ---------- ERP / Reporting ----------

enum ErpEntityType {
  CUSTOMER
  ITEM
  SALES_ORDER
  STOCK
}

enum ErpSyncDirection {
  PUSH
  PULL
}

enum ErpSyncStatus {
  SUCCESS
  FAILED
}

model ErpSyncLog {
  id         String           @id @default(cuid())
  entityType ErpEntityType
  entityId   String
  direction  ErpSyncDirection
  status     ErpSyncStatus
  payload    Json?
  error      String?
  syncedAt   DateTime         @default(now())

  @@index([entityType, entityId])
}
